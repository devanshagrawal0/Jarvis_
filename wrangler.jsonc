{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devansh-jarvis",
  "main": "worker/index.ts",
  "compatibility_date": "2025-12-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_ROOM",
        "class_name": "UserRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserRoom"]
    }
  ],
  "vars": {
    "APP_VERSION": "2026.06.16-spatial-agent-camera"
  }
}
