{
  "name": "jarvis-command-ui",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "dev:preview": "vite --host 127.0.0.1 --port %PORT%",
    "build": "vite build",
    "start": "node server.js",
    "app:dev": "electron .",
    "app:smoke": "electron . --smoke-test",
    "app:pack": "npm run build && electron-builder --dir",
    "app:build": "npm run app:build:win",
    "app:build:win": "npm run build && electron-builder --win portable",
    "app:build:mac": "npm run build && electron-builder --mac dmg zip",
    "check": "node --check server.js && tsc --noEmit && vite build",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "cf:build": "vite build && node scripts/build-cloud-assets.cjs",
    "cf:dev": "npm run cf:build && wrangler dev",
    "cf:deploy": "npm run cf:build && wrangler deploy",
    "cf:secret:gemini": "wrangler secret put GEMINI_API_KEY",
    "cf:secret:access": "wrangler secret put JARVIS_ACCESS_TOKEN",
    "cf:secret:relay": "wrangler secret put JARVIS_RELAY_SECRET",
    "reference:analyze": "node scripts/analyze-reference.mjs",
    "visual:capture": "node scripts/capture-jarvis-reference.mjs",
    "visual:compare": "node scripts/compare-jarvis-reference.mjs",
    "visual:reference": "npm run reference:analyze && npm run visual:capture && npm run visual:compare",
    "test:visual": "playwright test tests/visual/jarvis-reference.spec.ts",
    "test:feature": "playwright test tests/feature",
    "test:device-mesh-v2": "playwright test tests/feature/device-mesh-v2.spec.ts",
    "test:device-mesh-real-repair": "playwright test tests/feature/device-mesh-pairing-security.spec.ts tests/feature/device-mesh-qr-link.spec.ts tests/feature/device-mesh-phone-dashboard.spec.ts tests/feature/device-mesh-live-screen.spec.ts tests/feature/device-mesh-control-baton.spec.ts",
    "test:backend": "node --test --test-concurrency=1 tests/backend/*.test.js",
    "test:jarvis-system": "node scripts/jarvis-system-check.mjs",
    "test:jarvis-actions-memory": "node scripts/jarvis-actions-memory-check.mjs",
    "test:device-mesh": "node scripts/device-mesh-check.mjs",
    "test:coop-symbiote": "node scripts/coop-symbiote-check.mjs && playwright test tests/feature/coop-symbiote.spec.ts",
    "test:memory-os-v4": "node scripts/memory-os-v4-check.mjs",
    "test:device-mesh-repair": "node scripts/device-mesh-repair-check.mjs",
    "test:memory-os-v4-postrepair": "node scripts/post-repair-recheck.mjs memory",
    "test:device-mesh-postrepair": "node scripts/post-repair-recheck.mjs mesh",
    "test:postrepair": "node scripts/post-repair-recheck.mjs all",
    "test:memory-governance-master": "node scripts/memory-governance-master-check.mjs",
    "test:task-to-skill": "node scripts/task-to-skill-check.mjs",
    "test:local-file-access-protocols": "node scripts/local-file-access-protocols-check.mjs",
    "benchmark:latency": "node scripts/benchmark-latency.mjs",
    "test": "npm run check && npm run test:backend && npm run test:feature"
  },
  "build": {
    "appId": "dev.devansh.jarvis",
    "productName": "JARVIS OS",
    "asar": false,
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "dist/**/*",
      "public/**/*",
      "server.js",
      "server/**/*",
      "electron/**/*",
      "config/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": [
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deck.gl/geo-layers": "^9.3.5",
    "@deck.gl/layers": "^9.3.5",
    "@deck.gl/react": "^9.3.5",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/orbitron": "^5.2.8",
    "@google/genai": "^2.8.0",
    "@langchain/core": "^1.2.2",
    "@langchain/langgraph": "^1.4.7",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.3",
    "@loaders.gl/3d-tiles": "^4.4.3",
    "@loaders.gl/core": "^4.4.3",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@rive-app/canvas": "^2.38.1",
    "@tanstack/react-query": "^5.101.0",
    "@turf/turf": "^7.3.5",
    "@xyflow/react": "^12.11.2",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^5.0.0",
    "cloudflared": "^0.7.1",
    "cmdk": "^1.1.1",
    "d3": "^7.9.0",
    "deck.gl": "^9.3.5",
    "dockview-react": "^7.0.2",
    "echarts": "^6.1.0",
    "google-auth-library": "^10.7.0",
    "gsap": "^3.15.0",
    "lightweight-charts": "^5.2.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.18.0",
    "maplibre-gl": "^5.24.0",
    "meshline": "^3.3.1",
    "motion": "^12.42.2",
    "multer": "^2.2.0",
    "multicast-dns": "^7.2.5",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.61.0",
    "pmtiles": "^4.4.1",
    "postprocessing": "^6.39.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-ai-voice-visualizer": "^0.1.6",
    "react-dom": "^19.2.7",
    "react-force-graph": "^1.48.2",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.184.0",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/d3": "^7.4.3",
    "@types/multer": "^2.2.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wrangler": "^4.58.0"
  }
}
