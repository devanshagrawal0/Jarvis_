# ═══════════════════════════════════════════════════════════════════════
#  Jarvis Command OS — environment template
#  Copy this file to `.env` and fill in the keys you have. Everything is
#  optional except where noted — the app degrades gracefully and many data
#  sources work with NO key. `.env` is git-ignored and never committed.
# ═══════════════════════════════════════════════════════════════════════

# ── APEX market-data keys (all FREE tiers) ───────────────────────────────
# Finnhub — real-time equities quotes + company news   https://finnhub.io/register
APEX_FINNHUB_KEY=
# Tiingo — 30y daily history + IEX intraday            https://www.tiingo.com/account/api/token
APEX_TIINGO_KEY=
# FRED (St. Louis Fed) — macro series                  https://fredaccount.stlouisfed.org/apikeys
APEX_FRED_KEY=
# Marketaux — per-ticker news + sentiment              https://www.marketaux.com/
APEX_MARKETAUX_KEY=
# Alpha Vantage — history + fundamentals + FX          https://www.alphavantage.co/support/#api-key
APEX_ALPHAVANTAGE_KEY=
# CoinGecko (Demo) — crypto market data                https://www.coingecko.com/en/developers/dashboard
APEX_COINGECKO_KEY=
# (No key needed: GDELT, SEC EDGAR, NWS, Binance/Coinbase, Yahoo, Treasury, Stooq)

# ── Jarvis AI brain ──────────────────────────────────────────────────────
# Google Gemini — primary reasoning/answer model       https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
JARVIS_GEMINI_API_BASE_URL=
JARVIS_GEMINI_BUDGET_MS=12000
# OpenAI — optional alternate model
OPENAI_API_KEY=

# ── Research & web tools (optional) ──────────────────────────────────────
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
NEWS_API_KEY=

# ── Integrations (optional; enable the features that use them) ───────────
GITHUB_TOKEN=
FIGMA_ACCESS_TOKEN=
HIGGSFIELD_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
# Google OAuth (Calendar/Drive/Gmail actions)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCESS_TOKEN=

# ── Kalshi (event-contract trading, optional) ────────────────────────────
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=

# ── Device-mesh / runtime config (non-secret; sane defaults) ─────────────
JARVIS_HOST=127.0.0.1
JARVIS_URL=http://127.0.0.1:5173
JARVIS_RUNTIME_DIR=runtime
JARVIS_BROWSER_HEADLESS=true
JARVIS_DESKTOP_CONTROL_DRY_RUN=true
# JARVIS_BROKER_TOKEN=            # set to secure the device-mesh broker
# NODE_ENV=production
